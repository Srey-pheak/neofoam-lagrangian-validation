#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------
# Test 6: 5 particles in the lid-driven cavity. The air starts at rest and is
# SOLVED every step (neoIcoKinematicParcelFoam, one-way). U is written every
# step because scripts/replay_F.py rebuilds the particle paths from it.
#
# The time folders are KEPT (unlike test 5): the replay reads 0.005/U ... 3/U.
#
# Executor: system/controlDict says Serial. Override it for the CUDA build:
#   NEOFOAM_EXECUTOR=GPU NEOFOAM_BIN=<NeoFOAM>/build/production-cuda/bin ...
# (plain `CPU` is only compiled if Kokkos was built with OpenMP)
#
# Output: postProcessing/lagrangian/kinematicCloud/particles.csv, 0.005/U ... 3/U

# Open MPI 5 on some machines hangs in MPI_Init without mpirun (TCP transport)
export OMPI_MCA_btl=${OMPI_MCA_btl:-self,vader}
NEOFOAM_BIN=${NEOFOAM_BIN:?set NEOFOAM_BIN to <NeoFOAM>/build/production/bin}
NEOFOAM_EXECUTOR=${NEOFOAM_EXECUTOR:-}
# RunFunctions takes the application and the whole command line: keep "-executor"
# with its value, so the log is still named log.neoIcoKinematicParcelFoam.
if [ -n "$NEOFOAM_EXECUTOR" ]; then
    EXECUTOR_FLAG="-executor $NEOFOAM_EXECUTOR"
else
    EXECUTOR_FLAG=""
fi

restore0Dir

runApplication blockMesh

runApplication "$NEOFOAM_BIN/neoIcoKinematicParcelFoam" $EXECUTOR_FLAG

# ParaView: open <case>.foam with the built-in OpenFOAM reader
touch "${PWD##*/}.foam"

#------------------------------------------------------------------------------
