FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          PCG;
        preconditioner  diagonal;
        tolerance       1e-12;      // the cavity tutorial's 1e-06 stops the p solve at 0 iterations
        relTol          0.0;        // after t ~ 1 s; with 1e-12 the air matches icoFoam to round-off
    }

    U
    {
        solver          PBiCGStab;
        preconditioner  diagonal;
        tolerance       1e-12;      // as p
        relTol          0;
    }
}

PISO
{
    momentumPredictor        yes;
    nCorrectors              2;
    nNonOrthogonalCorrectors 0;
    pRefCell                 0;
    pRefValue                0;
}


