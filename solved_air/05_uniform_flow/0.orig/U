FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Solved flow. Uniform (2 0 0) in, zero gradient out, symmetry on the sides:
// with these boundaries the uniform field is an exact solution, so the solved
// air must stay (2 0 0) to solver tolerance (test 5 compares with test 3).
dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (2 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (2 0 0);
    }

    outlet
    {
        type            zeroGradient;
    }

    sides
    {
        type            symmetry;
    }
}

