#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------
# Test 5: the same three particles as test 3, in the same 1 m box, but the air
# is SOLVED (neoIcoKinematicParcelFoam: PISO + particles, one-way).
#
# Inlet U = (2 0 0), outlet p = 0, sides symmetry: uniform flow is an exact
# solution, so the particles must follow test 3's trajectories.
#
# Output: postProcessing/lagrangian/kinematicCloud/particles.csv

# Open MPI 5 on some machines hangs in MPI_Init without mpirun (TCP transport)
export OMPI_MCA_btl=${OMPI_MCA_btl:-self,vader}
NEOFOAM_BIN=${NEOFOAM_BIN:?set NEOFOAM_BIN to <NeoFOAM>/build/production/bin}

restore0Dir

runApplication blockMesh

runApplication "$NEOFOAM_BIN/neoIcoKinematicParcelFoam"

# The solver writes the particles to the CSV only; the time folders 0.0005 ...
# hold only OpenFOAM bookkeeping (written every step for the comparison).
# Remove them, keep 0/.
foamListTimes -rm > /dev/null

#------------------------------------------------------------------------------
