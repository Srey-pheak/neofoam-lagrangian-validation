FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Test 5: same geometry as test 3 (1 m box, 10 x 10 x 10 cells), but the single
// "sides" patch of C is split so an incompressible solver can run:
//   inlet  (x = 0)  fixed velocity (2 0 0)
//   outlet (x = 1)  fixed pressure 0
//   sides  (y, z)   symmetry: uniform flow is an exact solution, so the particles
//                   must follow the same trajectories as in test 3
scale   1;

L       1;

vertices
(
    (0  0  0) ($L 0  0) ($L $L 0) (0  $L 0)
    (0  0  $L) ($L 0  $L) ($L $L $L) (0  $L $L)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (10 10 10) simpleGrading (1 1 1)
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (1 2 6 5)
        );
    }
    sides
    {
        type symmetry;
        faces
        (
            (0 3 2 1) (4 5 6 7) (0 1 5 4) (3 7 6 2)
        );
    }
);

