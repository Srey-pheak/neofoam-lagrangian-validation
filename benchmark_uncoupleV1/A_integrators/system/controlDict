FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     neoIcoUncoupledKinematicParcelFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.2;
deltaT          0.001;

writeControl    timeStep;
writeInterval   1;              // every step -> full particle trajectory
purgeWrite      0;
writeFormat     ascii;
writePrecision  16;             // needed to compare with the replica at round-off
writeCompression off;
timeFormat      general;
timePrecision   10;
runTimeModifiable false;

