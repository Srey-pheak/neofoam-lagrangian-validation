FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      kinematicCloudProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solution
{
    active          true;
    coupled         false;      // one-way: air is frozen anyway
    transient       yes;
    cellValueSourceCorrection off;

    // IMPORTANT: KinematicParcel::move limits every sub-step to a fraction
    // maxCo of deltaT (f = min(f, maxCo)). maxCo = 1 -> exactly one particle
    // step per deltaT, which is required for a clean dt-convergence study.
    maxCo           1.0;

    interpolationSchemes
    {
        rho             cell;
        U               cell;
        mu              cell;
    }

    integrationSchemes
    {
        U               RK2;      // RK2: time error negligible at dt = 5e-4 (verified in test A)
    }
}

constantProperties
{
    rho0            2500;       // solid particle
    youngsModulus   1e9;        // required by colliding cloud, unused (no collisions)
    poissonsRatio   0.35;
}

subModels
{
    particleForces
    {
        stokesDrag;             // Stokes: CdRe = 24 (NeoFOAM only): exact solution per component
        gravity;
    }

    injectionModels
    {
        particle_d50       // d = 50 um, released at rest, carried by the wind
        {
            type            manualInjection;
            massTotal       0;
            parcelBasisType fixed;
            nParticle       1;
            SOI             0;
            positionsFile   "kinematicCloudPositions.d50";
            U0              (0 0 0);
            sizeDistribution
            {
                type        fixedValue;
                fixedValueDistribution
                {
                    value   5e-05;
                }
            }
        }
        particle_d40       // d = 40 um, pushed sideways (+y), then picked up by the wind
        {
            type            manualInjection;
            massTotal       0;
            parcelBasisType fixed;
            nParticle       1;
            SOI             0;
            positionsFile   "kinematicCloudPositions.d40";
            U0              (0 1 0);
            sizeDistribution
            {
                type        fixedValue;
                fixedValueDistribution
                {
                    value   4e-05;
                }
            }
        }
        particle_d60       // d = 60 um, released at rest near +x: leaves the domain
        {
            type            manualInjection;
            massTotal       0;
            parcelBasisType fixed;
            nParticle       1;
            SOI             0;
            positionsFile   "kinematicCloudPositions.d60";
            U0              (0 0 0);
            sizeDistribution
            {
                type        fixedValue;
                fixedValueDistribution
                {
                    value   6e-05;
                }
            }
        }
    }

    dispersionModel          none;
    patchInteractionModel    standardWallInteraction;
    standardWallInteractionCoeffs
    {
        type        rebound;            // never reached in this benchmark
    }
    surfaceFilmModel         none;
    stochasticCollisionModel none;
    collisionModel           none;
}

cloudFunctions
{}

