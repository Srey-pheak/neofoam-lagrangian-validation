FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      kinematicCloudProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solution
{
    active          true;
    coupled         false;      // one-way: air is frozen anyway
    transient       yes;
    cellValueSourceCorrection off;

    // IMPORTANT: KinematicParcel::move limits every sub-step to a fraction
    // maxCo of deltaT (f = min(f, maxCo)). maxCo = 1 -> exactly one particle
    // step per deltaT, which is required for a clean dt-convergence study.
    maxCo           1.0;

    interpolationSchemes
    {
        rho             cell;
        U               cell;
        mu              cell;
    }

    integrationSchemes
    {
        U               RK2;      // RK2: time error negligible at dt = 5e-5 (verified in test 1)
    }
}

constantProperties
{
    rho0            2500;       // solid particle
    youngsModulus   1e9;        // required by colliding cloud, unused (no collisions)
    poissonsRatio   0.35;
}

subModels
{
    particleForces
    {
        sphereDrag;             // sphereDrag | SchillerNaumannDrag | stokesDrag (set by scripts/run_B.sh)
        gravity;
    }

    injectionModels
    {
        particle_d10       // d = 10 um, released at rest
        {
            type            manualInjection;
            massTotal       0;
            parcelBasisType fixed;
            nParticle       1;
            SOI             0;
            positionsFile   "kinematicCloudPositions.d10";
            U0              (0 0 0);
            sizeDistribution
            {
                type        fixedValue;
                fixedValueDistribution
                {
                    value   1e-05;
                }
            }
        }
        particle_d50       // d = 50 um, released at rest
        {
            type            manualInjection;
            massTotal       0;
            parcelBasisType fixed;
            nParticle       1;
            SOI             0;
            positionsFile   "kinematicCloudPositions.d50";
            U0              (0 0 0);
            sizeDistribution
            {
                type        fixedValue;
                fixedValueDistribution
                {
                    value   5e-05;
                }
            }
        }
        particle_d100       // d = 100 um, released at rest
        {
            type            manualInjection;
            massTotal       0;
            parcelBasisType fixed;
            nParticle       1;
            SOI             0;
            positionsFile   "kinematicCloudPositions.d100";
            U0              (0 0 0);
            sizeDistribution
            {
                type        fixedValue;
                fixedValueDistribution
                {
                    value   0.0001;
                }
            }
        }
        particle_d200       // d = 200 um, released at rest
        {
            type            manualInjection;
            massTotal       0;
            parcelBasisType fixed;
            nParticle       1;
            SOI             0;
            positionsFile   "kinematicCloudPositions.d200";
            U0              (0 0 0);
            sizeDistribution
            {
                type        fixedValue;
                fixedValueDistribution
                {
                    value   0.0002;
                }
            }
        }
        particle_d500       // d = 500 um, released at rest
        {
            type            manualInjection;
            massTotal       0;
            parcelBasisType fixed;
            nParticle       1;
            SOI             0;
            positionsFile   "kinematicCloudPositions.d500";
            U0              (0 0 0);
            sizeDistribution
            {
                type        fixedValue;
                fixedValueDistribution
                {
                    value   0.0005;
                }
            }
        }
    }

    dispersionModel          none;
    patchInteractionModel    standardWallInteraction;
    standardWallInteractionCoeffs
    {
        type        rebound;            // never reached in this benchmark
    }
    surfaceFilmModel         none;
    stochasticCollisionModel none;
    collisionModel           none;
}

cloudFunctions
{}

